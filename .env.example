# Configuración pública de Supabase (segura para el cliente gracias a RLS)
# Si se dejan vacías, la aplicación funciona automáticamente en Modo Local/Offline (IndexedDB)
# con los 120 atletas y las 12 categorías precargadas para pruebas inmediatas.
VITE_SUPABASE_URL=https://tu-proyecto.supabase.co
VITE_SUPABASE_ANON_KEY=tu-anon-key-publica
VITE_DEFAULT_RACE_ID=a0000000-0000-4000-8000-000000000001
